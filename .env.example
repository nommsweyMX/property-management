# Copy to .env ON YOUR HOST, outside the public directory. Never commit it.
# Live is fail-closed unless all required settings below are valid.
APP_MODE=live
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=https://YOUR-PRIVATE-SITE.example
# Grant this token access only to the selected property base (records read/write).
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
# Google OAuth client of type Web application; allow PUBLIC_ORIGIN as JS origin.
GOOGLE_CLIENT_ID=
# Comma-separated authoritative Gmail/Workspace identities allowed to bootstrap owners.
OWNER_EMAILS=
# Optional Gmail sending authorization for this WEB APP, not the ChatGPT connector.
# Refresh token must be issued to the client above with gmail.send scope.
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=
# Persist this PRIVATE directory across restarts. Do not serve it as static files.
DATA_DIR=.data
# Local-only demo: APP_MODE=demo. Never silently switch a live deployment to demo.
